# Backend
OPENAI_API_KEY=
GOOGLE_API_KEY=
# LLM cho expand/translate query + temporal + intelligent. deepseek (mặc định) | openai.
# DeepSeek dùng API tương thích OpenAI, rẻ hơn ~10x. Thiếu key -> tự fallback provider còn lại.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=AIC_data
QDRANT_CAPTION_COLLECTION=keyframe-captions
ES_HOST=localhost
ES_PORT=9200
ES_ASR_INDEX=asr_data
ES_OCR_INDEX=ocr_data
HF_HOME=./temp_cache

# Model locations and placement.  Keep retrieval encoders on GPU; put BEiT-3
# and BGE on CPU so all channels can stay enabled on a 12 GB GPU.
BGE_MODEL=BAAI/bge-m3
BGE_DEVICE=cpu
BEIT3_CKPT=model_weights/beit3_large_patch16_384_coco_retrieval.pth
BEIT3_TOKENIZER=model_weights/beit3.spm
BEIT3_DEVICE=cpu
BLIP2_MODEL=Salesforce/blip2-itm-vit-g
BLIP2_DEVICE=cuda
BLIP2_BATCH=8

ENABLE_SIGLIP=1
ENABLE_JINA=1
ENABLE_BGE=1
ENABLE_BEIT3=1
ENABLE_BLIP2=1
# Requires a non-empty OPENAI_API_KEY.  Leave at 0 if no credential is present.
ENABLE_GPT_EXPANSION=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KIS_MAX_CONCURRENCY=1
KIS_QUEUE_TIMEOUT_SECONDS=30

# Web UI (web/server.js)
API_URL=http://localhost:8000
DRES_URL=https://eventretrieval.oj.io.vn
DATA_ROOT=.
VIDEO_DIRS=data/video,data/videos,videos
